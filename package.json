{
  "name": "dsh-orca-terminal-status",
  "version": "0.1.0",
  "description": "Bridge real DeepSeek Harness TUI lifecycle to Orca terminal readiness and completion.",
  "type": "module",
  "license": "MIT",
  "author": "Alex-wangyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-wangyang/dsh-orca-terminal-status.git"
  },
  "bugs": {
    "url": "https://github.com/Alex-wangyang/dsh-orca-terminal-status/issues"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
