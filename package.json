    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-harness-tui/dsh-tui": "0.13.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-harness-tui/dsh-tui": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orca",
    "cordis",
    "tui"
  ]
}
